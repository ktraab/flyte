## Game-event SFX using Kenney audio pack as disc golf sound stand-ins.
## Auto-wires to EventBus. Respects "SFX" / "Music" buses from Settings.
## Background music: drop .mp3/.ogg files into res://assets/audio/music/
##   Season-aware naming: prefix with "spring_", "summer_", "fall_", "winter_"
##   Unprefixed tracks play in all seasons (e.g. Morning_in_the_Fairway.mp3).
extends Node

const _SND   := "res://assets/audio/Sounds/"
const _UI    := "res://assets/audio/ui/kenney_ui-audio/Audio/"
const _MUSIC := "res://assets/audio/music/"
const _SFX   := "res://assets/audio/sfx/"   # generated by tools/gen_sfx.py

# SFX cooldowns — throttle high-frequency events to avoid wall of sound
const _ARRIVE_COOLDOWN := 4.0
const _LAUNCH_COOLDOWN := 0.4   # max ~2.5 disc throws audible per second
const _LAND_COOLDOWN   := 0.5   # max 2 landings audible per second

var _sounds:         Dictionary = {}
var _all_tracks:     Array      = []   # all discovered tracks: {path, seasons: Array}
var _music_tracks:   Array      = []   # current season's playlist (paths)
var _music_player:   AudioStreamPlayer
var _music_idx:      int        = 0
var _current_season: String     = ""
var _arrive_timer:   float      = 0.0
var _launch_timer:   float      = 0.0
var _land_timer:     float      = 0.0
var _impact_timers:  Dictionary = {}   # kind → cooldown left
const _IMPACT_COOLDOWN := 0.25
const _IMPACT_DB := {"chains": -6.0, "rim": -10.0, "tree": -9.0, "rock": -10.0, "splash": -8.0}

func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS  # keep sounds/music alive while paused
	_build_music_player()
	_scan_music_folder()
	_load_sounds()
	EventBus.day_changed.connect(_on_day_changed)

	EventBus.disc_launched.connect(func():
		if _launch_timer <= 0.0:
			_play("launch", -14.0)
			_launch_timer = _LAUNCH_COOLDOWN)
	EventBus.disc_landed.connect(func(p: int):
		if _land_timer <= 0.0:
			_play("penalty" if p > 0 else "land", -16.0)
			_land_timer = _LAND_COOLDOWN)
	EventBus.disc_impact.connect(_on_disc_impact)
	EventBus.hole_scored.connect(_on_hole_scored)
	EventBus.round_completed.connect(func(_id: String, _v: bool, _e: float, _h: int): _play("round_done"))
	EventBus.goal_completed.connect(func(_id: String, _t: String, _r: float): _play("goal"))
	EventBus.tournament_started.connect(func(): _play("tourney_start"))
	EventBus.tournament_completed.connect(func(_p: float): _play("tourney_end"))
	EventBus.vip_arrived.connect(func(_id: String): _play("vip", -3.0))
	EventBus.npc_arrived.connect(_on_npc_arrived)
	EventBus.income_received.connect(func(amt: float, _src: String):
		if amt >= 50.0: _play("cash", -18.0))

func _process(delta: float) -> void:
	if _arrive_timer > 0.0: _arrive_timer -= delta
	if _launch_timer > 0.0: _launch_timer -= delta
	if _land_timer   > 0.0: _land_timer   -= delta
	for k in _impact_timers:
		_impact_timers[k] = maxf(0.0, float(_impact_timers[k]) - delta)

## Fade music out and back in. Once faded out the stream is paused, so there
## is genuinely no music (STORY.md final card).
const MUSIC_DB := -6.0
var _duck_tween: Tween = null

func set_music_ducked(ducked: bool) -> void:
	if _music_player == null:
		return
	if _duck_tween and _duck_tween.is_valid():
		_duck_tween.kill()
	_duck_tween = create_tween()
	if ducked:
		_duck_tween.tween_property(_music_player, "volume_db", -60.0, 2.0)
		_duck_tween.tween_callback(func() -> void: _music_player.stream_paused = true)
	else:
		_music_player.stream_paused = false
		_duck_tween.tween_property(_music_player, "volume_db", MUSIC_DB, 1.5)

## Ambient wind/birds bed (assets/audio/ambient/wind_loop.wav, generated by
## tools/gen_ambient_wind.py — original, no license strings attached).
const AMBIENT_PATH := "res://assets/audio/ambient/wind_loop.wav"
const AMBIENT_DB := -8.0
var _ambient_player: AudioStreamPlayer = null
var _ambient_tween: Tween = null
var _ambient_on: bool = false

## Music out, nature in — used under the final memorial card.
func set_ambient_only(on: bool) -> void:
	set_music_ducked(on)
	_ambient_on = on
	if _ambient_player == null:
		_ambient_player = AudioStreamPlayer.new()
		_ambient_player.bus = "Music" if AudioServer.get_bus_index("Music") >= 0 else "Master"
		_ambient_player.volume_db = -60.0
		if ResourceLoader.exists(AMBIENT_PATH):
			_ambient_player.stream = load(AMBIENT_PATH) as AudioStream
		add_child(_ambient_player)
		# Safety net in case the import loses its loop flag.
		_ambient_player.finished.connect(func() -> void:
			if _ambient_on: _ambient_player.play())
	if _ambient_tween and _ambient_tween.is_valid():
		_ambient_tween.kill()
	_ambient_tween = create_tween()
	if on:
		if not _ambient_player.playing and _ambient_player.stream:
			_ambient_player.play()
		_ambient_tween.tween_property(_ambient_player, "volume_db", AMBIENT_DB, 2.5)
	else:
		_ambient_tween.tween_property(_ambient_player, "volume_db", -60.0, 1.5)
		_ambient_tween.tween_callback(_ambient_player.stop)

func is_ambient_only() -> bool:
	return _ambient_on

func _build_music_player() -> void:
	_music_player = AudioStreamPlayer.new()
	_music_player.bus = "Music"
	_music_player.volume_db = MUSIC_DB
	add_child(_music_player)
	_music_player.finished.connect(_on_track_finished)

const _SEASON_PREFIXES := ["spring_", "summer_", "fall_", "winter_"]

func _scan_music_folder() -> void:
	# DirAccess.open("res://...") fails in exported builds — scan if available,
	# then fall back to explicitly listed tracks so exports always have music.
	var dir := DirAccess.open(_MUSIC)
	if dir:
		dir.list_dir_begin()
		var file := dir.get_next()
		while file != "":
			if file.ends_with(".ogg") or file.ends_with(".mp3") or file.ends_with(".wav"):
				var seasons: Array = []
				var lower := file.to_lower()
				for pfx in _SEASON_PREFIXES:
					if lower.begins_with(pfx):
						seasons.append(pfx.rstrip("_"))
						break
				# No season prefix → plays all seasons
				_all_tracks.append({"path": _MUSIC + file, "seasons": seasons})
			file = dir.get_next()
		dir.list_dir_end()
	if _all_tracks.is_empty():
		_all_tracks.append({"path": _MUSIC + "Morning_in_the_Fairway.mp3", "seasons": []})
	_build_season_playlist("")
	_play_music_track(0)

func _build_season_playlist(season: String) -> void:
	_music_tracks = []
	for t in _all_tracks:
		var td: Dictionary = t as Dictionary
		var seasons: Array = td["seasons"] as Array
		# Include track if it has no season tag (universal) or matches current season
		if seasons.is_empty() or season in seasons:
			_music_tracks.append(td["path"] as String)
	if _music_tracks.is_empty():
		# Fallback: include all tracks if none match
		for t in _all_tracks:
			_music_tracks.append((t as Dictionary)["path"] as String)
	_music_tracks.shuffle()

func _on_day_changed(_day: int, season: String) -> void:
	if season == _current_season:
		return
	_current_season = season
	var current_path: String = _music_tracks[_music_idx] if not _music_tracks.is_empty() else ""
	_build_season_playlist(season)
	# Don't interrupt current track; new playlist applies on next track
	# If current track isn't in new playlist, fade to next track
	if current_path not in _music_tracks and _music_player.playing:
		_play_music_track(0)

func _play_music_track(idx: int) -> void:
	if _music_tracks.is_empty():
		return
	_music_idx = idx % _music_tracks.size()
	var s := load(_music_tracks[_music_idx]) as AudioStream
	if s:
		_music_player.stream = s
		_music_player.play()

func _on_track_finished() -> void:
	_play_music_track(_music_idx + 1)

func _load_sounds() -> void:
	var map := {
		"launch":        _SND + "tap-a.ogg",
		"land":          _SND + "tap-b.ogg",
		"penalty":       _SND + "click-b.ogg",
		"good_score":    _SND + "switch-a.ogg",
		"great_score":   _SND + "switch-b.ogg",
		"bad_score":     _SND + "click-a.ogg",
		"round_done":    _UI  + "switch7.ogg",
		"goal":          _UI  + "switch14.ogg",
		"tourney_start": _UI  + "switch21.ogg",
		"tourney_end":   _UI  + "switch28.ogg",
		"vip":           _UI  + "switch10.ogg",
		"cash":          _UI  + "mouseclick1.ogg",
		"arrive":        _UI  + "rollover1.ogg",
		"chains":        _SFX + "chains.wav",
		"tree":          _SFX + "tree.wav",
		"rock":          _SFX + "rock.wav",
		"rim":           _SFX + "rock.wav",
		"splash":        _SFX + "splash.wav",
	}
	for k in map:
		var s := load(map[k] as String) as AudioStream
		if s:
			_sounds[k] = s

func _on_hole_scored(_hole_idx: int, _throws: int, _par: int, diff: int) -> void:
	if diff <= -2:
		_play("great_score")
	elif diff == -1:
		_play("good_score")
	elif diff >= 2:
		_play("bad_score", -6.0)

func _on_disc_impact(kind: String, _pos: Vector3) -> void:
	if float(_impact_timers.get(kind, 0.0)) > 0.0:
		return
	_impact_timers[kind] = _IMPACT_COOLDOWN
	_play(kind, float(_IMPACT_DB.get(kind, -8.0)))

func _on_npc_arrived(_id: String) -> void:
	if _arrive_timer <= 0.0:
		_play("arrive", -24.0)
		_arrive_timer = _ARRIVE_COOLDOWN

func _play(key: String, extra_db: float = 0.0) -> void:
	if not _sounds.has(key):
		return
	var p := AudioStreamPlayer.new()
	p.stream = _sounds[key] as AudioStream
	p.volume_db = extra_db
	p.bus = "SFX"
	p.finished.connect(p.queue_free)
	add_child(p)
	p.play()
