; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Flyte: A Disc Golf Course Builder and Manager"
config/version="1.1.0"
run/main_scene="uid://cnhvmbthive3"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"
config/run/main_scene="res://scenes/main/Main.tscn"

[audio]

default_bus_layout="res://default_bus_layout.tres"

[autoload]

EventBus="*res://autoloads/EventBus.gd"
PlatformDetector="*res://autoloads/PlatformDetector.gd"
GameManager="*res://autoloads/GameManager.gd"
InputHandler="*res://autoloads/InputHandler.gd"
SaveSystem="*res://autoloads/SaveSystem.gd"
UIManager="*res://autoloads/UIManager.gd"
EconomyManager="*res://core/economy/EconomyManager.gd"
GoalsSystem="*res://autoloads/GoalsSystem.gd"
StoryManager="*res://autoloads/StoryManager.gd"
LevelSystem="*res://autoloads/LevelSystem.gd"
UIAudio="*res://autoloads/UIAudio.gd"
UpdateChecker="*res://autoloads/UpdateChecker.gd"
GameAudio="*res://autoloads/GameAudio.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

