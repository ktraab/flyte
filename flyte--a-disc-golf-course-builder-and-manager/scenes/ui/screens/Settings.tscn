[node name="MechVBox" type="VBoxContainer" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="RatingHeader" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
text = "COURSE RATING  (★ Stars)"
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.5, 0.85, 1.0, 1.0)

[node name="RatingText" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
autowrap_mode = 3
text = "Each hole gets 0–5 stars based on: distance (longer = better), fairway coverage, hazards (water & trees add excitement), variety (rough terrain), and restroom proximity. Your overall course rating is the average across all holes. Higher ratings attract better players and increase income."

[node name="Sep1" type="HSeparator" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2

[node name="HappinessHeader" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
text = "PLAYER HAPPINESS"
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.5, 0.85, 1.0, 1.0)

[node name="HappinessText" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
autowrap_mode = 3
text = "Happiness (0–100%) = course quality (50%) + restrooms (20%) + food stands (15%) + pro shop (15%). Low happiness means fewer members, VIPs skip your course, and income drops. Build amenities and keep the course in good condition to maintain high happiness."

[node name="Sep2" type="HSeparator" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2

[node name="TournamentsHeader" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
text = "TOURNAMENTS"
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.5, 0.85, 1.0, 1.0)

[node name="TournamentsText" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
autowrap_mode = 3
text = "Requires 6+ holes and ≥ 2.0 star rating. Runs for 90 seconds — extra players flood the course and spend heavily. Prize = $500 + (holes × $80) + (rating × $200). 8-minute cooldown between events. Great for burst income."

[node name="Sep3" type="HSeparator" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2

[node name="EventsHeader" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
text = "SPECIAL EVENTS"
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.5, 0.85, 1.0, 1.0)

[node name="EventsText" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
autowrap_mode = 3
text = "Discount Day: free, temporarily boosts visit rate. Pro Invitational: $500, needs a Pro Shop, raises prestige. Night Golf: $200, needs Restroom + Food Stand. Charity Round: $300, 2-day, needs 9+ holes — awards prestige on completion. Each event has a cooldown."

[node name="Sep4" type="HSeparator" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2

[node name="VIPHeader" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
text = "VIPs & TOURING PROS"
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.5, 0.85, 1.0, 1.0)

[node name="VIPText" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
autowrap_mode = 3
text = "VIPs appear when happiness ≥ 60% (12% base chance, +5% per Disc Pro staff member). They pay 3× the green fee and carry a gold dot. VIP satisfaction affects prestige. Having a Pro Shop on course is strongly recommended to attract touring pros."

[node name="Sep5" type="HSeparator" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2

[node name="StaffHeader" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
text = "STAFF"
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.5, 0.85, 1.0, 1.0)

[node name="StaffText" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
autowrap_mode = 3
text = "Groundskeeper: slows course condition decay. Disc Pro: boosts VIP chance and applies an income multiplier. Concessions Worker: adds passive food income (requires Food Stands). All staff have 3 upgrade tiers — upgrade via the Staff Dashboard for greater effect."

[node name="Sep6" type="HSeparator" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2

[node name="ConditionHeader" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
text = "COURSE CONDITION"
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.5, 0.85, 1.0, 1.0)

[node name="ConditionText" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
autowrap_mode = 3
text = "Condition decays 1%/day naturally. Below 75% it reduces income (down to 60% at 0%). Groundskeepers slow the decay. Use 'Repair Course' (Staff panel) to restore to 100% — costs $500 + $100 per hole. Keep condition above 75% for full income."

[node name="Sep7" type="HSeparator" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2

[node name="PrestigeHeader" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
text = "PRESTIGE"
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.5, 0.85, 1.0, 1.0)

[node name="PrestigeText" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
autowrap_mode = 3
text = "Prestige (0–100) unlocks World Circuit destinations. Formula: course rating 35% + happiness 30% + facilities (restroom/food/pro shop) 20% + tournament activity 10% + goals completed 5%. Tiers: Local Legend → Regional → National → World Class. Higher tiers unlock better World Circuit courses."

[node name="Sep8" type="HSeparator" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2

[node name="PartiesHeader" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
text = "PLAYER PARTIES"
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.5, 0.85, 1.0, 1.0)

[node name="PartiesText" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
autowrap_mode = 3
text = "Players arrive in parties of 1–4. Each party member pays their own green fee. Larger parties generate more revenue per visit. Parties are more common with higher marketing spend and happiness. Each player in the party has an individual skill level."

[node name="Sep9" type="HSeparator" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2

[node name="NeedsHeader" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
text = "PLAYER NEEDS"
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.5, 0.85, 1.0, 1.0)

[node name="NeedsText" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
autowrap_mode = 3
text = "Every NPC tracks hunger, thirst, and bathroom need. Meters drain while playing. If any meter maxes out with no nearby facility, the player leaves early — you lose the rest of their green fee. Food Stands satisfy hunger and thirst. Restrooms satisfy bathroom need. Place facilities near busy holes for best coverage."

[node name="Sep10" type="HSeparator" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2

[node name="DecorHeader" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
text = "DECOR & AESTHETICS"
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.5, 0.85, 1.0, 1.0)

[node name="DecorText" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
autowrap_mode = 3
text = "Bench, Flower Bed, and Sculpture give a small per-hole bonus when placed nearby (binary — one piece is the same as two). Up to 20 pieces globally count toward your happiness and rating score. Lamp Post, Sign, and Garden are purely cosmetic — no gameplay effect, just visual atmosphere."

[node name="Sep11" type="HSeparator" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2

[node name="XPHeader" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
text = "XP & LEVELING"
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.5, 0.85, 1.0, 1.0)

[node name="XPText" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
autowrap_mode = 3
text = "Earn XP to level from Rookie (L1) to Hall of Fame (L10). Sources: 1 XP per tile placed, 8 XP per hole an NPC plays, +15 XP bonus when a VIP completes a round, 150 XP for purchasing a World Circuit course, 75 XP per goal completed. Your level and title are shown in the HUD."

[node name="Sep12" type="HSeparator" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2

[node name="GoalsHeader" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
text = "GOALS"
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.5, 0.85, 1.0, 1.0)

[node name="GoalsText" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
autowrap_mode = 3
text = "12 progressive goals auto-track milestones: first hole complete, revenue targets, player count, star rating, and more. Completing a goal pays a cash reward plus 75 XP. Only one goal is active at a time — check progress in the Goals panel. Goals persist across sessions."

[node name="Sep13" type="HSeparator" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2

[node name="EmpireHeader" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
text = "WORLD CIRCUIT & EMPIRE"
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.5, 0.85, 1.0, 1.0)

[node name="EmpireText" type="Label" parent="CenterBox/Panel/Margin/MainVBox/TabContainer/Mechanics/MechVBox"]
layout_mode = 2
autowrap_mode = 3
text = "Buy real-world courses (Maple Ridge, Winthrop Gold, Idlewild, Disc Side of Heaven, Krokhol, Ale White) with Empire Balance — funds shared across all your locations. Each course runs its own economy; income accrues in the background while you manage other courses. Affiliate shops (Disc Depot, Bag Shack, WDGA HQ, Bromez) unlock in tiers for passive empire income."

